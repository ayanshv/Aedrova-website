{
  "$schema": "https://stripe.com/stripe-app.schema.json",
  "id": "com.aedrova.buds",
  "name": "Aedrova Buds",
  "version": "0.1.0",
  "icon": "icon.png",
  "extensions": null,
  "permissions": [
    {
      "permission": "connected_account_read",
      "purpose": "Verify the Stripe account you authorize for your Finance Bud."
    },
    {
      "permission": "balance_read",
      "purpose": "Let your Finance Bud summarize your available and pending Stripe balance."
    }
  ],
  "allowed_redirect_uris": [
    "https://aedrova-connectors.onrender.com/buds/oauth/stripe/callback"
  ],
  "distribution_type": "public",
  "stripe_api_access_type": "oauth",
  "sandbox_install_compatible": true
}