# Private values belong in your server's secret store. Never put them in the Mac app.
AEDROVA_ORIGIN=http://127.0.0.1:8090
AEDROVA_PRODUCTION=false
AEDROVA_DATABASE=sqlite:///work/site.sqlite3
# Generate once, store securely and retain across deploys. Changing it expires encrypted sessions.
AEDROVA_ENCRYPTION_KEY=
AEDROVA_STRIPE_KEY=
AEDROVA_WEBHOOK_SECRET=
AEDROVA_OPENAI_KEY=
AEDROVA_ANTHROPIC_KEY=
# Copy plans.example.json, replace the two Stripe IDs, and use that file here.
AEDROVA_PLANS_FILE=config/plans.example.json
AEDROVA_MODELS_FILE=config/models.beta.json
# Optional one-time $10 USD product buying $5 of AI usage; no recurring interval.
AEDROVA_TOPUP_PRICE_ID=
AEDROVA_DOWNLOAD_PATH=
AEDROVA_DOWNLOAD_SHA256=
# Public checkout stays closed until ALL launch gates and live acceptance are completed.
AEDROVA_GATEWAY_ENABLED=false
AEDROVA_RELEASE_READY=false
AEDROVA_LEGAL_READY=false
AEDROVA_CHECKOUT_ENABLED=false
