# Server-only staging: separate project/data, OAuth registrations and encryption key.
# Never copy production credentials here. Copy to ignored .env.staging, chmod 600.
AEDROVA_DEPLOYMENT_ENVIRONMENT=staging
AEDROVA_PRODUCTION=true
AEDROVA_ORIGIN=https://YOUR-STAGING-SERVICE
AEDROVA_SUPABASE_URL=https://YOUR-STAGING-PROJECT-REF.supabase.co
AEDROVA_SUPABASE_KEY=YOUR-STAGING-PUBLISHABLE-KEY
AEDROVA_DATABASE=postgresql+psycopg://aedrova_website.YOUR-STAGING-PROJECT-REF:YOUR-STAGING-ROLE-PASSWORD@YOUR-SESSION-POOLER.pooler.supabase.com:5432/postgres?sslmode=require
AEDROVA_SUPABASE_DATABASE=true
AEDROVA_DB_POOL_SIZE=1
AEDROVA_DB_MAX_OVERFLOW=0
AEDROVA_ENCRYPTION_KEY=YOUR-UNIQUE-STAGING-FERNET-KEY
AEDROVA_WAITLIST_ONLY=false
AEDROVA_DOTS_ENABLED=true
AEDROVA_CHECKOUT_ENABLED=false
AEDROVA_GATEWAY_ENABLED=false
AEDROVA_DEVELOPMENT_AI=false
AEDROVA_FREE_ENABLED=false
AEDROVA_MEETINGS_ENABLED=false
AEDROVA_MEETING_CONTEXT_ENABLED=false
AEDROVA_SPEECH_ENABLED=false
AEDROVA_RELEASE_READY=false
AEDROVA_LEGAL_READY=false
AEDROVA_STRIPE_TEST_MODE=true
# Add only staging provider app credentials after authorized setup; no live Stripe keys.
