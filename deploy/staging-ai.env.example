# Proposed overlay for the EXISTING aedrova-beta-staging service only.
# Not applied automatically. Requires owner approval for key transfer/inference.
# Keep current database, encryption, Supabase and connector settings unchanged.
# Put existing OpenAI key privately in AEDROVA_OPENAI_KEY; never commit its value.
AEDROVA_MODELS_FILE=config/models.openai.json
AEDROVA_GATEWAY_ENABLED=true
AEDROVA_FREE_ENABLED=true
# Accounting ceilings across this staging ledger, including other metered usage.
AEDROVA_COMPANY_BUDGET_MICROUSD=1000000
AEDROVA_FREE_POOL_MICROUSD=1000000
AEDROVA_GATEWAY_MAX_CONCURRENCY=2
AEDROVA_PROVIDER_DEADLINE_SECONDS=90
# Staging stays isolated; no paid checkout, installers or meeting activation.
AEDROVA_WAITLIST_ONLY=false
AEDROVA_CHECKOUT_ENABLED=false
AEDROVA_RELEASE_READY=false
AEDROVA_DEVELOPMENT_AI=false
# Claude intentionally omitted until its provider credit balance is funded.
# After separate approval: configure server-only AEDROVA_ANTHROPIC_KEY and switch
# AEDROVA_MODELS_FILE=config/models.beta.json, then repeat real metered acceptance.
