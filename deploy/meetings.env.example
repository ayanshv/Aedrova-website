# Upload these values to BOTH the API and worker secret stores. No keys in the image.
# Use the host-provided HTTPS address; a purchased domain is optional.
AEDROVA_ORIGIN=https://REPLACE_WITH_HOST_ADDRESS
AEDROVA_PRODUCTION=true
# API only: actual trusted ingress proxy IPs/CIDRs; empty means ignore forwarded headers.
AEDROVA_TRUSTED_PROXY_IPS=
AEDROVA_DATABASE=postgresql+psycopg://REPLACE_WITH_PRIVATE_DATABASE_CONNECTION
AEDROVA_ENCRYPTION_KEY=REPLACE_WITH_STABLE_FERNET_KEY
AEDROVA_MEETINGS_ENABLED=true
AEDROVA_LIVEKIT_URL=wss://REPLACE_WITH_PROJECT.livekit.cloud
AEDROVA_LIVEKIT_API_KEY=REPLACE_LOCALLY
AEDROVA_LIVEKIT_API_SECRET=REPLACE_LOCALLY
# Meeting staging does not activate paid AI, checkout, downloads or legal release gates.
AEDROVA_GATEWAY_ENABLED=false
AEDROVA_CHECKOUT_ENABLED=false
AEDROVA_RELEASE_READY=false
AEDROVA_LEGAL_READY=false
