# Upload these values to BOTH the API and worker secret stores. No keys in the image.
# Render staging: one shared environment group; do not commit actual values.
AEDROVA_ORIGIN=https://aedrova-meetings.onrender.com
AEDROVA_PRODUCTION=true
# API only: actual trusted ingress proxy IPs/CIDRs; empty means ignore forwarded headers.
AEDROVA_TRUSTED_PROXY_IPS=
AEDROVA_DATABASE=postgresql+psycopg://aedrova_website.cpelagtufyocepnqcqqd:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
AEDROVA_SUPABASE_DATABASE=true
AEDROVA_DB_POOL_SIZE=1
AEDROVA_DB_MAX_OVERFLOW=0
AEDROVA_WAITLIST_ONLY=false
AEDROVA_ENCRYPTION_KEY=REPLACE_WITH_STABLE_FERNET_KEY
AEDROVA_MEETINGS_ENABLED=true
# M14 only: apply meeting-context migration and acceptance checks before enabling.
AEDROVA_MEETING_CONTEXT_ENABLED=false
# M12D: staging only after both SQL migrations, provider privacy/cost approval and acceptance.
AEDROVA_SPEECH_ENABLED=false
# API only. Enter in the host secret store; never bundle it or paste it in chat.
AEDROVA_SPEECH_KEY=
AEDROVA_LIVEKIT_URL=wss://REPLACE_WITH_PROJECT.livekit.cloud
AEDROVA_LIVEKIT_API_KEY=REPLACE_LOCALLY
AEDROVA_LIVEKIT_API_SECRET=REPLACE_LOCALLY
# Meeting staging does not activate paid AI, checkout, downloads or legal release gates.
AEDROVA_GATEWAY_ENABLED=false
AEDROVA_CHECKOUT_ENABLED=false
AEDROVA_RELEASE_READY=false
AEDROVA_LEGAL_READY=false
