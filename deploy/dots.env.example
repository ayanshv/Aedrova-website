# SERVER ONLY. Copy to an ignored .env.dots; never commit real credentials.
# Layer with the existing local server configuration so its DB/encryption key stay stable.
AEDROVA_DOTS_ENABLED=true
AEDROVA_GITHUB_DOT_CLIENT_ID=
AEDROVA_GITHUB_DOT_CLIENT_SECRET=
# Optional signed events; leave blank until an approved public HTTPS ingress exists.
AEDROVA_GITHUB_DOT_WEBHOOK_SECRET=
# Existing AEDROVA_ORIGIN must match the GitHub callback, Google redirect and service.
# Reuse existing AEDROVA_DATABASE and AEDROVA_ENCRYPTION_KEY from the current server.

# Browser-based Bud connectors. Configure each pair only when its app is registered.
AEDROVA_FIGMA_BUD_CLIENT_ID=
AEDROVA_FIGMA_BUD_CLIENT_SECRET=
AEDROVA_NOTION_BUD_CLIENT_ID=
AEDROVA_NOTION_BUD_CLIENT_SECRET=
AEDROVA_SUPABASE_BUD_CLIENT_ID=
AEDROVA_SUPABASE_BUD_CLIENT_SECRET=
AEDROVA_TIKTOK_BUD_CLIENT_ID=
AEDROVA_TIKTOK_BUD_CLIENT_SECRET=
